# LeiMoz - Configuração Local (Mock Mode)
# Copie para .env e ajuste conforme necessário

DATABASE_URL="postgresql://leimoz:leimozpassword@localhost:5432/leimoz"

OLLAMA_URL="http://localhost:11434"

LLM_MODEL="llama3.2"

EMBEDDING_MODEL="nomic-embed-text"

PORT=3000

# Modo mock - usa embeddings determinísticos e respostas pré-definidas
# Não necessita de Ollama para testes locais
MOCK_MODE=true
